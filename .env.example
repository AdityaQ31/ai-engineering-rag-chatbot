EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local paths on YOUR machine; these are not portable to another computer.
BASE_MODEL_PATH=D:/Jupyter/projects/Llama-3.2-1B-Instruct
ADAPTER_PATH=D:/Jupyter/projects/Llama-3.2-1B-QLoRA-Final
